title: "From coding-agent explanation to VS Code player"
agent hex/hex-agent/blue "Coding agent" "Claude or Codex"
specs box/files/orange "Explainer sources" "JSON + Kymo"
watcher box/gear/green "VS Code watcher" "Debounced file events"
builder box/gear/orange "build.mjs" "Validation and caching"
layout_engine box/magnifier/blue "Kymo renderer" "Local SVG layout"
html box/files/green "index.html" "Offline player"
viewer box/notebook/blue "Native webview" "VS Code editor"
layout { agent | specs | { watcher , builder } | { html , layout_engine } | viewer }
agent --> specs : "author"
specs --> builder : "build"
builder --> layout_engine : "layout"
layout_engine --> builder : "SVG"
builder --> html : "write"
html --> watcher : "changed"
watcher --> viewer : "open"
specs --> watcher : "saved"
watcher --> builder : "rebuild"
